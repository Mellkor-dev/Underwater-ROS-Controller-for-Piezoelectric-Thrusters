<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="underwater_world">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Required Gazebo Harmonic Systems -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>

    <!-- Buoyancy System: Water density 1000 kg/m^3 -->
    <plugin
      filename="gz-sim-buoyancy-system"
      name="gz::sim::systems::Buoyancy">
      <uniform_fluid_density>1000</uniform_fluid_density>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>  
    <plugin
      filename="gz-sim-apply-link-wrench-system"
      name="gz::sim::systems::ApplyLinkWrench">
    </plugin>
      
    

    <!-- GUI Configuration with 0.05 m grid and underwater camera -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.25 0.45 0.6</ambient_light>
        <background_color>0.1 0.25 0.4</background_color>
        <camera_pose>-0.6 0.6 0.45 0 0.35 -0.785</camera_pose>
      </plugin>

      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <!-- World control (Play/Pause/Step) -->
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <use_event>true</use_event>
      </plugin>

      <!-- World statistics -->
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <!-- Custom 0.05m (5cm) Grid Config -->
      <plugin filename="GridConfig" name="Grid config">
        <gz-gui>
          <title>Grid Config</title>
        </gz-gui>
        <insert>
          <horizontal_cell_count>100</horizontal_cell_count>
          <vertical_cell_count>0</vertical_cell_count>
          <cell_length>0.05</cell_length>
          <pose>0 0 0.001 0 0 0</pose>
          <color>0.2 0.45 0.55 0.7</color>
        </insert>
      </plugin>
      
    </gui>

    <!-- Gravity -->
    <gravity>0 0 -9.81</gravity>

    <!-- Underwater Scene Lighting and Fog (inspired by Plankton underwater worlds) -->
    <scene>
      <ambient>0.2 0.35 0.5 1.0</ambient>
      <background>0.08 0.2 0.35 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Underwater Light (attenuated as in water) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.5 0.7 0.85 1</diffuse>
      <specular>0.3 0.4 0.5 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.8</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
      <direction>-0.3 0.1 -0.9</direction>
    </light>

    <!-- Tank / Seabed Floor -->
    <model name="tank_bottom">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1000000.0</kp>
                <kd>100.0</kd>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 0.3 0.35 1</ambient>
            <diffuse>0.25 0.35 0.4 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Water Surface Visual (translucent plane at z = 1.0m) -->
    <model name="water_surface">
      <static>true</static>
      <pose>0 0 1.0 0 0 0</pose>
      <link name="surface_link">
        <visual name="surface_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.1 0.4 0.6 0.3</ambient>
            <diffuse>0.2 0.5 0.7 0.3</diffuse>
            <specular>0.6 0.8 1.0 0.5</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

