#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist
from nav_msgs.msg import Odometry
from sensor_msgs.msg import FluidPressure

class DepthHoldPID(Node):
    def __init__(self):
        super().__init__('depth_hold_pid')

        # Command publisher to controller
        self.cmd_pub = self.create_publisher(Twist, '/cmd_vel', 10)

        # Ground truth pose / pressure depth subscriber
        self.odom_sub = self.create_subscription(
            Odometry, '/model/Centroid_body/odometry', self.odom_callback, 10
        )

        # Control Loop Timer (50 Hz matching PJA pulse rate)
        self.update_rate = 50.0  # Hz
        self.timer = self.create_timer(1.0 / self.update_rate, self.control_loop)

        # Target Depth (Meters, negative underwater: -0.5m target hover)
        self.target_depth = -0.5
        self.current_depth = 0.0

        # PID Gains (Calibrated for 85g CSUR in water with 50mN PJA limits)
        self.Kp = 1.8   # Proportional response to depth error
        self.Ki = 0.05  # Integral accumulator for static negative buoyancy bias
        self.Kd = 0.8   # Derivative damping against vertical water drag

        # Controller State
        self.integral_error = 0.0
        self.prev_error = 0.0
        self.last_time = self.get_clock().now()

        # Teleop pass-through variables
        self.user_surge = 0.0
        self.user_yaw = 0.0

        self.get_logger().info(f'PJA Depth-Hold PID Initialized. Target Depth: {self.target_depth} m')

    def odom_callback(self, msg: Odometry):
        # Extract Z position directly from Odometry
        self.current_depth = msg.pose.pose.position.z

    def control_loop(self):
        now = self.get_clock().now()
        dt = (now - self.last_time).nanoseconds * 1e-9
        if dt <= 0.0:
            return
        self.last_time = now

        # Depth Error e(t) = target_z - current_z
        error = self.target_depth - self.current_depth

        # Integral term with anti-windup clamping
        self.integral_error += error * dt
        self.integral_error = max(-1.0, min(1.0, self.integral_error))

        # Derivative term (de/dt)
        derivative_error = (error - self.prev_error) / dt
        self.prev_error = error

        # PID Output -> Maps directly to heave demand u_heave in [0.0, 1.0]
        # Base feed-forward term + PID correction
        u_heave = (self.Kp * error) + (self.Ki * self.integral_error) + (self.Kd * derivative_error)

        # Modulate thrust demand: Saturate heave demand between 0.0 and 1.0 duty cycle
        u_heave_clamped = max(0.0, min(1.0, u_heave))

        # Construct Twist command
        cmd_msg = Twist()
        cmd_msg.linear.z = u_heave_clamped  # Vertical PJA Duty Cycle Modulation
        cmd_msg.linear.x = self.user_surge
        cmd_msg.angular.z = self.user_yaw

        self.cmd_pub.publish(cmd_msg)

def main(args=None):
    rclpy.init(args=args)
    node = DepthHoldPID()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()